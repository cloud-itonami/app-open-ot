{ config, lib, pkgs, ... }:

let
  cfg = config.open-ot.checkpointer;
in {
  options.open-ot.checkpointer = {
    enable = lib.mkEnableOption "RisingWave checkpointer client config (consumed by langgraph-service)";

    dsn = lib.mkOption {
      type = lib.types.str;
      example = "REDACTED_USE_DATABASE_URL_ENV";
      description = ''
        PostgreSQL-protocol DSN to RisingWave (per ADR-0048). Real
        deployments inject this via `agenix` / `sops-nix` — do NOT
        commit a DSN with credentials.
      '';
    };

    schema = lib.mkOption {
      type = lib.types.str;
      default = "graphar";
      description = "Schema holding `vertex_open_ot_*` tables.";
    };

    loopCheckpointTable = lib.mkOption {
      type = lib.types.str;
      default = "vertex_open_ot_loop_checkpoint";
      description = "Per-super-step checkpoint table (SPEC §6).";
    };

    signalChangeTable = lib.mkOption {
      type = lib.types.str;
      default = "vertex_open_ot_signal_change";
      description = "Single-task / row-driven trigger source (SPEC §6).";
    };

    bulkInsertRateRowsPerSec = lib.mkOption {
      type = lib.types.int;
      default = 50000;
      description = ''
        `SET dml_rate_limit` per CLAUDE.md `[[conventions]]
        rw-bulk-insert-throttle`. Telemetry batches must throttle so a
        bursty Mimi cluster doesn't trip the RW per-account quota
        (incident 2026-04-25, ADR-0048).
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    # Surface the config to other modules via /etc/open-ot/checkpointer.toml.
    # langgraph-service.nix mounts this as the orchestrator's config source.
    environment.etc."open-ot/checkpointer.toml".text = ''
      # Generated by nixos/atama/modules/checkpointer-client.nix — do not edit.
      [checkpointer]
      dsn               = "${cfg.dsn}"
      schema            = "${cfg.schema}"
      loop_checkpoint   = "${cfg.loopCheckpointTable}"
      signal_change     = "${cfg.signalChangeTable}"
      bulk_insert_rate  = ${toString cfg.bulkInsertRateRowsPerSec}
    '';
  };
}
