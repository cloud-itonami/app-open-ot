{
  "@context": "https://etzhayyim.com/ns/open-ot/cell/v1",
  "name": "mppt-perturb-observe",
  "description": "IEC 61499 MPPT_PERTURB_OBSERVE BFB — PV array Maximum Power Point Tracking via Perturb & Observe (100 Hz field-tier)",
  "fb_kind": "BFB",
  "iec61499_fbtype": "MPPT_PERTURB_OBSERVE",
  "abi": {
    "init_export": "mppt_perturb_observe_init",
    "tick_export": "mppt_perturb_observe_tick"
  },
  "ecc": {
    "states": ["Idle", "Searching", "AtMpp", "Alarm"],
    "initial": "Idle",
    "transitions": [
      { "from": "*",  "event": "REQ", "guard": "v.q==bad||i.q==bad||v.q==stale||i.q==stale", "to": "Alarm" },
      { "from": "*",  "event": "REQ", "guard": "!enable",                                    "to": "Idle" },
      { "from": "*",  "event": "REQ", "guard": "v_min>=v_max||step<=0||tol<=0",              "to": "Alarm" },
      { "from": "*",  "event": "REQ", "guard": "abs(power-last_power)<=tol",                 "to": "AtMpp" },
      { "from": "*",  "event": "REQ", "guard": "default",                                    "to": "Searching" }
    ]
  },
  "events_in":  [{ "name": "REQ", "with": ["pv_voltage_micro_v", "pv_current_micro_a", "voltage_quality", "current_quality", "enable"] }],
  "events_out": [
    { "name": "CNF", "with": ["voltage_setpoint_micro_v", "power_pw", "direction", "mpp_reached"] },
    { "name": "ALM", "with": [] }
  ],
  "data_in_schema": [
    { "name": "pv_voltage_micro_v", "rust_type": "i32",  "wire": "valueMicroUnit", "unitCode": "uV" },
    { "name": "pv_current_micro_a", "rust_type": "i32",  "wire": "valueMicroUnit", "unitCode": "uA" },
    { "name": "voltage_quality",    "rust_type": "u8",   "wire": "qualityEnum" },
    { "name": "current_quality",    "rust_type": "u8",   "wire": "qualityEnum" },
    { "name": "enable",             "rust_type": "bool", "wire": "boolean" }
  ],
  "data_out_schema": [
    { "name": "voltage_setpoint_micro_v", "rust_type": "i32",  "wire": "valueMicroUnit", "unitCode": "uV" },
    { "name": "power_pw",                 "rust_type": "i64",  "wire": "valueMicroUnit", "unitCode": "pW" },
    { "name": "direction",                "rust_type": "u8",   "wire": "perturbDirEnum" },
    { "name": "mpp_reached",              "rust_type": "bool", "wire": "boolean" }
  ],
  "params_schema": [
    { "name": "perturb_step_micro_v", "rust_type": "i32", "description": "Step size per perturbation in uV (typical 100_000 = 0.1 V)" },
    { "name": "v_min_micro_v",        "rust_type": "i32", "description": "Lower voltage clamp in uV" },
    { "name": "v_max_micro_v",        "rust_type": "i32", "description": "Upper voltage clamp (V_oc) in uV" },
    { "name": "mpp_tolerance_pw",     "rust_type": "i64", "description": "MPP convergence threshold in pW" },
    { "name": "cycle_period_ms",      "rust_type": "u32" }
  ],
  "internal_schema": [
    { "name": "last_voltage_setpoint_micro_v", "rust_type": "i32",  "checkpoint": true },
    { "name": "last_power_pw",                 "rust_type": "i64",  "checkpoint": true },
    { "name": "direction",                     "rust_type": "u8",   "checkpoint": true },
    { "name": "initialized",                   "rust_type": "bool", "checkpoint": true }
  ],
  "tick_max_emitted": 1,
  "tick_max_neighbor_msgs": 0,
  "constraints": {
    "no_alloc_after_init": true,
    "no_float": true,
    "no_std_time": true,
    "no_rng": true,
    "deterministic_replay": true
  }
}
