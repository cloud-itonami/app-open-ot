{
  "@context": "https://etzhayyim.com/ns/open-ot/cell/v1",
  "name": "soc-kalman",
  "description": "IEC 61499 SOC_KALMAN BFB — battery State-of-Charge estimator (Coulomb counter + OCV-SOC correction blended via static Kalman gain)",
  "fb_kind": "BFB",
  "iec61499_fbtype": "SOC_KALMAN",
  "abi": {
    "init_export": "soc_kalman_init",
    "tick_export": "soc_kalman_tick"
  },
  "ecc": {
    "states": ["Idle", "Tracking", "LowConfidence", "Saturated", "Alarm"],
    "initial": "Idle",
    "transitions": [
      { "from": "*",  "event": "REQ", "guard": "v.q==bad||i.q==bad||v.q==stale||i.q==stale",       "to": "Alarm" },
      { "from": "*",  "event": "REQ", "guard": "!enable",                                          "to": "Idle" },
      { "from": "*",  "event": "REQ", "guard": "capacity<=0 || ocv0>=ocv100 || gain>1000 || ts==0", "to": "Alarm" },
      { "from": "*",  "event": "REQ", "guard": "confidence<200",                                   "to": "LowConfidence" },
      { "from": "*",  "event": "REQ", "guard": "soc<=5_000 || soc>=95_000",                        "to": "Saturated" },
      { "from": "*",  "event": "REQ", "guard": "default",                                          "to": "Tracking" }
    ]
  },
  "events_in":  [{ "name": "REQ", "with": ["voltage_micro_v", "current_micro_a", "temp_milli_c", "voltage_quality", "current_quality", "enable"] }],
  "events_out": [
    { "name": "CNF", "with": ["soc_milli_pct", "ocv_estimated_micro_v", "coulomb_delta_micro_c", "confidence_milli"] },
    { "name": "ALM", "with": [] }
  ],
  "data_in_schema": [
    { "name": "voltage_micro_v",   "rust_type": "i64",  "wire": "valueMicroUnit", "unitCode": "uV" },
    { "name": "current_micro_a",   "rust_type": "i64",  "wire": "valueMicroUnit", "unitCode": "uA" },
    { "name": "temp_milli_c",      "rust_type": "i32",  "wire": "valueMilliUnit", "unitCode": "milli-°C" },
    { "name": "voltage_quality",   "rust_type": "u8",   "wire": "qualityEnum" },
    { "name": "current_quality",   "rust_type": "u8",   "wire": "qualityEnum" },
    { "name": "enable",            "rust_type": "bool", "wire": "boolean" }
  ],
  "data_out_schema": [
    { "name": "soc_milli_pct",            "rust_type": "i32",  "wire": "valueMilliUnit", "unitCode": "milli-percent" },
    { "name": "ocv_estimated_micro_v",    "rust_type": "i64",  "wire": "valueMicroUnit", "unitCode": "uV" },
    { "name": "coulomb_delta_micro_c",    "rust_type": "i64",  "wire": "valueMicroUnit", "unitCode": "uC" },
    { "name": "confidence_milli",         "rust_type": "u16",  "wire": "valueMilliUnit", "unitCode": "milli (0..1000)" }
  ],
  "params_schema": [
    { "name": "capacity_micro_c",              "rust_type": "i64", "description": "Battery capacity in uC (Ah × 3600e6)" },
    { "name": "internal_resistance_micro_ohm", "rust_type": "i64", "description": "Internal resistance in uΩ" },
    { "name": "ocv_at_0_pct_micro_v",          "rust_type": "i64", "description": "OCV at 0 % SOC (uV)" },
    { "name": "ocv_at_100_pct_micro_v",        "rust_type": "i64", "description": "OCV at 100 % SOC (uV)" },
    { "name": "correction_gain_milli",         "rust_type": "u16", "description": "Static Kalman gain 0..1000 (= 0..1.0)" },
    { "name": "cycle_period_ms",               "rust_type": "u32" }
  ],
  "internal_schema": [
    { "name": "soc_milli_pct",               "rust_type": "i32",  "checkpoint": true },
    { "name": "coulomb_accumulator_micro_c", "rust_type": "i64",  "checkpoint": true },
    { "name": "confidence_milli",            "rust_type": "u16",  "checkpoint": true },
    { "name": "initialized",                 "rust_type": "bool", "checkpoint": true }
  ],
  "tick_max_emitted": 1,
  "tick_max_neighbor_msgs": 0,
  "constraints": {
    "no_alloc_after_init": true,
    "no_float": true,
    "no_std_time": true,
    "no_rng": true,
    "deterministic_replay": true
  }
}
